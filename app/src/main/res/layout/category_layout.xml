<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/category_ImgView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/salary"
        android:background="@drawable/img_bg"
        app:tint="?attr/colorAccent"
        android:padding="10dp"
        android:layout_margin="10dp"
        />

    <TextView
        android:id="@+id/category_txtView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rubik_light"
        android:text="Salary"
        android:textColor="?attr/colorAccent"
        app:layout_constraintEnd_toEndOf="@+id/category_ImgView"
        app:layout_constraintStart_toStartOf="@+id/category_ImgView"
        app:layout_constraintTop_toBottomOf="@+id/category_ImgView" />


</androidx.constraintlayout.widget.ConstraintLayout>