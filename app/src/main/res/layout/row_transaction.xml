<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/tranImg"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/transport"
        app:tint="?attr/colorAccent"
        android:background="@drawable/img_bg"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:contentDescription="Category Icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:orientation="vertical"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tranImg"
        app:layout_constraintStart_toEndOf="@+id/tranImg"
        app:layout_constraintTop_toTopOf="@+id/tranImg">

        <TextView
            android:id="@+id/tranNoteTxv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_bold"
            android:text="Bus"
            android:textSize="19sp"
            android:textColor="?attr/colorAccent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tranCatTxv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rubik_light"
                android:textColor="?attr/colorAccent"
                android:text="Transport" />

            <TextView
                android:id="@+id/tranDateTxv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rubik_light"
                android:textColor="?attr/colorAccent"
                android:text="29 June, 2026"
                android:layout_marginStart="10dp"/>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tranAmountTxv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:fontFamily="@font/rubik_bold"
        android:text="-500"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linearLayout4" />

</androidx.constraintlayout.widget.ConstraintLayout>